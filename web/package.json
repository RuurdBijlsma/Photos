{
  "name": "ruurd-photos",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p lint:type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "lint:type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint:format": "prettier --write src/",
    "lint:build": "run-s build",
    "lint": "run-s lint:*",
    "prettier:check": "prettier --check src/",
    "proto:gen": "protoc --plugin=protoc-gen-ts_proto=.\\node_modules\\.bin\\protoc-gen-ts_proto.cmd --ts_proto_out=./src/scripts/types/generated --ts_proto_opt=esModuleInterop=true --proto_path=./src/proto src/proto/timeline.proto"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.35",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "maplibre-gl": "^6.2.0",
    "pannellum": "^2.5.7",
    "pinia": "^4.0.2",
    "tus-js-client": "^4.3.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.8"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@prettier/plugin-oxc": "^0.2.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-oxlint": "~1.77.0",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.77.0",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "ts-proto": "^2.12.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.9"
  }

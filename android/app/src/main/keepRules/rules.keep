# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# JNI callbacks into AvifDecoder and AvifDecoder$Info.
-keep class org.aomedia.avif.android.** { *; }

# Protobuf JavaLite looks up generated message fields (e.g. `upserted_`, `PARSER`) by name via reflection.
-keepclassmembers class * extends com.google.protobuf.GeneratedMessageLite { <fields>; }

# Keep Navigation Compose type-safe @Serializable route classes/objects and their serializers under R8 full mode.
-keep,includedescriptorclasses @kotlinx.serialization.Serializable class dev.ruurd.photos.core.navigation.** { *; }
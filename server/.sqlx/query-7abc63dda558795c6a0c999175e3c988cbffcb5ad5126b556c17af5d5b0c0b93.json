  "query": "\n        SELECT\n            job_type AS \"job_type: JobType\",\n            status AS \"status: JobStatus\",\n            COUNT(*)::bigint AS \"count!\"\n        FROM jobs\n        WHERE user_id = $1\n          AND job_type IN ('ingest_metadata', 'ingest_thumbnails', 'ingest_analysis', 'ingest_llm')\n        GROUP BY job_type, status\n        ",

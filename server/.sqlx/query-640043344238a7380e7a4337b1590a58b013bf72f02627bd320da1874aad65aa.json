  "db_name": "PostgreSQL",
  "query": "\n        SELECT mi.id, mi.relative_path, mi.user_id, mi.has_thumbnails,\n               NOT EXISTS (\n                   SELECT 1 FROM visual_analysis va WHERE va.media_item_id = mi.id\n               ) AS \"needs_analysis!\"\n        FROM media_item mi\n        WHERE mi.deleted = false AND mi.missing_since IS NULL\n        ",

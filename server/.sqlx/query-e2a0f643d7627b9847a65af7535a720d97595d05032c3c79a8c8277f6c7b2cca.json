  "query": "\n        SELECT g.location_id as \"location_id!\", m.id as \"media_id!\"\n        FROM media_item m\n        JOIN gps g ON m.id = g.media_item_id\n        WHERE m.user_id = $1 AND g.location_id = ANY($2) AND m.deleted = false\n        ",
